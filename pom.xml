<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.maas</groupId>
        <artifactId>parent</artifactId>
        <version>2026.06</version>
        <relativePath/>
    </parent>
    <groupId>nl.maas.bankbook</groupId>
    <artifactId>bankbook</artifactId>
    <version>2026.01-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Bankbook</name>
    <modules>
        <module>bankbook-backend</module>
        <module>bankbook-frontend</module>
        <module>bankbook-client</module>
        <module>bankbook-packaging</module>
    </modules>
    <scm>
        <connection>scm:git:https://github.com/MichelMaas/bank-book.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/MichelMaas/bank-book.git</developerConnection>
        <url>https://github.com/MichelMaas/bank-book</url>
        <tag>HEAD</tag>
    </scm>
    <properties>
        <java.version>21</java.version>
        <wicket.framework.lib.version>2026.08</wicket.framework.lib.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <deb.outputDirectory>${maven.multiModuleProjectDirectory}/target/debs</deb.outputDirectory>
        <maven-assembly-plugin.version>3.5.0</maven-assembly-plugin.version>
        <jpackage.app.name>BankBook</jpackage.app.name>
        <jpackage.vendor>Michel Maas</jpackage.vendor>

        <jpackage.main.jar>
            ${project.build.finalName}-exec.jar
        </jpackage.main.jar>

        <jpackage.icon>
            ${project.basedir}/bin/icon.png
        </jpackage.icon>

        <jpackage.assembly.descriptor>
            ${project.basedir}/assembly.xml
        </jpackage.assembly.descriptor>
    </properties>
    <repositories>
        <repository>
            <id>reposilite-repository-releases</id>
            <url>http://mnw-repo.mnw:8080/releases</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <javaParameters>true</javaParameters>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>--add-opens=java.base/java.time=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <deployAtEnd>true</deployAtEnd>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>package-linux-deb</id>
        </profile>
    </profiles>
</project>
