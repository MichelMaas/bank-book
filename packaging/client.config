#!/bin/sh
set -eu
. /usr/share/debconf/confmodule
# Keep the current system default visible during reconfiguration/upgrades.
if [ "${1:-}" = reconfigure ] && [ -f /etc/bankbook/client.properties ]; then
  current=$(sed -n 's/^server\.url=//p' /etc/bankbook/client.properties | head -n 1)
  if [ -n "$current" ]; then db_set bankbook-client/server-url "$current"; fi
fi
while :; do
  db_input high bankbook-client/server-url || true
  db_go
  db_get bankbook-client/server-url
  if /usr/bin/python3 - "$RET" <<'PY'
import sys,urllib.parse
s=sys.argv[1].strip()
try:
 p=urllib.parse.urlsplit(s);port=p.port
 assert p.scheme in ('http','https') and p.hostname and not p.username and not p.password and not p.query and not p.fragment
 assert port is None or 0<port<=65535
 assert all(ord(c)>=33 and ord(c)!=127 for c in s)
except (ValueError,AssertionError):sys.exit(1)
PY
  then break; fi
  db_input critical bankbook-client/invalid-url || true
  db_go
  db_fset bankbook-client/server-url seen false
  # Never loop forever in a noninteractive install with a bad preseed.
  if [ "${DEBIAN_FRONTEND:-}" = noninteractive ]; then exit 1; fi
done
